-- ==================================================================
-- FASE 1: PLACE EGG — SCAN → PLACE KE SLOT KOSONG
-- ==================================================================
local function placeEggsFromBackpack()
    local totalSlots = #CONFIG.eggGridOffsets
    
    -- =========================================
    -- STEP 1: Tunggu server settle
    -- =========================================
    task.wait(CONFIG.scanSettleDelay)
    
    -- =========================================
    -- STEP 2: SCAN slot — snapshot keadaan garden
    -- =========================================
    local emptySlots, occupied = getEmptySlots()
    
    print("[Place] === SCAN SLOT ===")
    for i = 1, totalSlots do
        if occupied[i] then
            print(string.format("[Place]   Slot %d: TERISI", i))
        else
            print(string.format("[Place]   Slot %d: KOSONG", i))
        end
    end
    
    if #emptySlots == 0 then
        updateStatus("⚠️ Garden penuh")
        return 0
    end
    
    updateStatus(string.format("📦 %d slot kosong", #emptySlots))
    
    -- =========================================
    -- STEP 3: Cek egg tool
    -- =========================================
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return 0 end
    
    local function findEggTool()
        for _, tool in ipairs(backpack:GetChildren()) do
            if isEggTool(tool) then
                local eggName = tool:GetAttribute("h")
                local count = tool:GetAttribute("e") or 0
                if count > 0 and (next(CONFIG.selectedEggs) == nil or CONFIG.selectedEggs[eggName]) then
                    return tool
                end
            end
        end
        return nil
    end
    
    local eggTool = findEggTool()
    if not eggTool then
        updateStatus("⚠️ Tidak ada egg")
        return 0
    end
    
    -- =========================================
    -- STEP 4: Equip egg tool
    -- =========================================
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return 0 end
    
    pcall(function() humanoid:EquipTool(eggTool) end)
    task.wait(0.5)
    
    -- =========================================
    -- STEP 5: Place HANYA ke slot kosong
    -- =========================================
    local center = getCenterPoint()
    if not center then return 0 end
    
    local placed = 0
    
    print("[Place] === PLACE KE SLOT KOSONG ===")
    for _, slotIndex in ipairs(emptySlots) do
        if not isRunning then break end
        
        local currentEggTool = findEggTool()
        if not currentEggTool then
            print("[Place] Egg habis")
            break
        end
        
        -- Equip kalau belum
        local equippedTool = character:FindFirstChild(currentEggTool.Name)
        if not equippedTool then
            pcall(function() humanoid:EquipTool(currentEggTool) end)
            task.wait(0.5)
        end
        
        -- Place
        local pos = center.Position + CONFIG.eggGridOffsets[slotIndex]
        print(string.format("[Place] Place slot %d: %s", slotIndex, tostring(pos)))
        
        local ok = pcall(function()
            PetEggService:FireServer("CreateEgg", pos)
        end)
        
        if ok then
            placed = placed + 1
            updateStatus(string.format("📦 Place %d/%d (slot %d)", placed, #emptySlots, slotIndex))
            task.wait(CONFIG.placeDelay)
        else
            print("[Place] Gagal slot " .. slotIndex)
        end
    end
    
    print(string.format("[Place] Total: %d egg", placed))
    return placed
end

-- ==================================================================
-- FASE 2: SATU CYCLE
-- ==================================================================
local function runOneCycle(cycleNum, totalCycles)
    -- FASE 1: Place
    updateStatus(string.format("[%d/%d] 📦 Place egg...", cycleNum, totalCycles))
    local placed = placeEggsFromBackpack()
    
    local existingEggs = getMyGardenEggs()
    local allReady = false
    
    if placed == 0 then
        updateStatus(string.format("[%d/%d] ⚠️ Garden penuh, cek timer...", cycleNum, totalCycles))
        if #existingEggs == 0 then
            updateStatus(string.format("[%d/%d] ⚠️ Tidak ada egg", cycleNum, totalCycles))
            return false
        end
        
        allReady = true
        local readyCount = 0
        for _, egg in ipairs(existingEggs) do
            local t = egg:GetAttribute("TimeToHatch") or 999
            if t > 0 then allReady = false
            else readyCount = readyCount + 1 end
        end
        
        if allReady then
            updateStatus(string.format("[%d/%d] ✅ %d egg ready, skip Speed", cycleNum, totalCycles, readyCount))
        else
            updateStatus(string.format("[%d/%d] ⏳ %d/%d ready, perlu Speed", cycleNum, totalCycles, readyCount, #existingEggs))
        end
    else
        updateStatus(string.format("[%d/%d] ✅ %d egg di-place", cycleNum, totalCycles, placed))
    end
    
    task.wait(2)
    
    -- FASE 2: Tim Speed
    if not allReady then
        updateStatus(string.format("[%d/%d] ⚡ Tim Speed...", cycleNum, totalCycles))
        equipTeamByPreset(CONFIG.speedPreset, CONFIG.speedLoadout)
        task.wait(CONFIG.delayAfterSpeed)
        
        updateStatus(string.format("[%d/%d] ⏳ Menunggu ready...", cycleNum, totalCycles))
        local waitStart = os.clock()
        local maxWait = 900
        
        while (os.clock() - waitStart) < maxWait and isRunning do
            local eggs = getMyGardenEggs()
            if #eggs == 0 then break end
            
            local readyAll = true
            local readyCount = 0
            for _, egg in ipairs(eggs) do
                local t = egg:GetAttribute("TimeToHatch") or 0
                if t > 0 then
                    readyAll = false
                    if CONFIG.autoSkip then
                        skipHatch(egg)
                        task.wait(CONFIG.skipDelay)
                    end
                else
                    readyCount = readyCount + 1
                end
            end
            
            if readyAll then break end
            updateStatus(string.format("[%d/%d] ⏳ %d/%d ready", cycleNum, totalCycles, readyCount, #eggs))
            task.wait(3)
        end
        
        if not isRunning then return false end
        updateStatus(string.format("[%d/%d] ✅ Semua ready!", cycleNum, totalCycles))
        task.wait(1)
    else
        updateStatus(string.format("[%d/%d] ⏭️ Skip Speed", cycleNum, totalCycles))
    end
    
    -- FASE 3: Tim Hatch
    updateStatus(string.format("[%d/%d] 🥚 Tim Hatch...", cycleNum, totalCycles))
    equipTeamByPreset(CONFIG.hatchPreset, CONFIG.hatchLoadout)
    task.wait(CONFIG.delayAfterHatch)
    
    updateStatus(string.format("[%d/%d] 🥚 Hatch...", cycleNum, totalCycles))
    local eggsToHatch = {}
    for _, egg in ipairs(getMyGardenEggs()) do
        local t = egg:GetAttribute("TimeToHatch") or 999
        if t <= 0 then table.insert(eggsToHatch, egg) end
    end
    
    for _, egg in ipairs(eggsToHatch) do
        if not isRunning then break end
        hatchEgg(egg)
        task.wait(CONFIG.hatchDelay)
    end
    
    local timeout = os.clock() + 60
    while isRunning and os.clock() < timeout do
        local hasReadyEgg = false
        for _, egg in ipairs(getMyGardenEggs()) do
            local t = egg:GetAttribute("TimeToHatch") or 999
            if t <= 0 then hasReadyEgg = true break end
        end
        if not hasReadyEgg then break end
        task.wait(1)
    end
    
    updateStatus(string.format("[%d/%d] ✅ Cycle selesai", cycleNum, totalCycles))
    task.wait(2)
    return true
end

-- ==================================================================
-- FASE 4: FILTER + SELL
-- ==================================================================
local function runFilterAndSell()
    if not CONFIG.autoSell then return end
    
    updateStatus("💸 Tim Sell...")
    equipTeamByPreset(CONFIG.sellPreset, CONFIG.sellLoadout)
    task.wait(CONFIG.delayAfterSell)
    
    updateStatus("⭐ Filter pet...")
    local favCount = 0
    local unfavCount = 0
    local skipCount = 0
    local presetProtectCount = 0
    
    for _, pet in ipairs(getBackpackPets()) do
        if not isRunning then return end
        
        if isPetInPreset(pet.name) then
            if not pet.isFavorited then
                toggleFavorit(pet.tool)
                presetProtectCount = presetProtectCount + 1
            end
        else
            local unwanted = isUnwantedPet(pet)
            if not unwanted then
                if not pet.isFavorited then
                    toggleFavorit(pet.tool)
                    favCount = favCount + 1
                end
            else
                if pet.isFavorited then
                    toggleFavorit(pet.tool)
                    unfavCount = unfavCount + 1
                end
                skipCount = skipCount + 1
            end
        end
    end
    
    updateStatus(string.format("⭐ Preset:%d Fav:%d Unfav:%d Skip:%d", 
        presetProtectCount, favCount, unfavCount, skipCount))
    task.wait(2)
    
    updateStatus("🔍 Verifikasi...")
    task.wait(1)
    
    local verifyFail = 0
    for _, pet in ipairs(getBackpackPets()) do
        if isPetInPreset(pet.name) then
            if not pet.isFavorited then
                verifyFail = verifyFail + 1
                toggleFavorit(pet.tool)
            end
        else
            local unwanted = isUnwantedPet(pet)
            if not unwanted then
                if not pet.isFavorited then
                    verifyFail = verifyFail + 1
                    toggleFavorit(pet.tool)
                end
            else
                if pet.isFavorited then
                    verifyFail = verifyFail + 1
                    toggleFavorit(pet.tool)
                end
            end
        end
    end
    
    if verifyFail > 0 then
        updateStatus(string.format("⚠️ Verifikasi: %d fixed", verifyFail))
        task.wait(2)
    else
        updateStatus("✅ Verifikasi OK")
    end
    
    updateStatus("⏳ Delay sebelum sell...")
    task.wait(CONFIG.delayBeforeSell)
    
    updateStatus("💰 Sell all...")
    sellAll()
    task.wait(2)
    
    updateStatus("✅ Sell selesai")
end

-- ==================================================================
-- MAIN LOOP
-- ==================================================================
local function startAutoHatch()
    if isRunning then return end
    isRunning = true
    
    task.spawn(function()
        while isRunning and not guiDestroyed do
            for cycle = 1, CONFIG.cycleCount do
                if not isRunning or guiDestroyed then break end
                runOneCycle(cycle, CONFIG.cycleCount)
            end
            
            if not isRunning or guiDestroyed then break end
            runFilterAndSell()
            
            if not isRunning or guiDestroyed then break end
            updateStatus("🔄 Cycle baru...")
