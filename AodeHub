local function refreshUnwantedList()
    for _, c in ipairs(listFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local search = searchBox.Text:lower()
    local petTypes = getAllPetTypesFromRegistry()
    local i = 0
    local selectedCount = 0
    for _, petType in ipairs(petTypes) do
        if search == "" or petType:lower():find(search) then
            i = i + 1
            local isSelected = CONFIG.unwantedPetTypes[petType] == true
            if isSelected then selectedCount = selectedCount + 1 end
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -4, 0, 20)
            btn.BackgroundColor3 = isSelected and C.danger or Color3.fromRGB(65, 65, 80)
            btn.BorderSizePixel = 0
            btn.Font = Enum.Font.Gotham
            btn.Text = string.format("%s %s", isSelected and "✓" or "○", petType)
            btn.TextColor3 = C.text
            btn.TextSize = 8
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.LayoutOrder = i
            btn.Parent = listFrame
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 6)
            pad.Parent = btn
            btn.MouseButton1Click:Connect(function()
                if CONFIG.unwantedPetTypes[petType] then
                    CONFIG.unwantedPetTypes[petType] = nil
                else
                    CONFIG.unwantedPetTypes[petType] = true
                end
                saveConfig()
                refreshUnwantedList()
            end)
        end
    end
    countLabel.Text = string.format("Total: %d pet | Terpilih: %d", i, selectedCount)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(refreshUnwantedList)

-- INIT
refreshEggList()
