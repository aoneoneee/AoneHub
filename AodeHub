local function getMyGardenEggs()
    local eggs = {}
    for _, egg in CollectionService:GetTagged("PetEggServer") do
        if egg:GetAttribute("OWNER") == player.Name then
            table.insert(eggs, egg)
        end
    end
    return eggs
