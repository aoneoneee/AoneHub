-- ==================================================================
local function ensureFavorit(tool, shouldBeFavorite, timeout)
    timeout = timeout or 2
    local current = tool:GetAttribute("d") == true
    
    if current == shouldBeFavorite then
        return true
    end
    
    pcall(function() FavoriteItemRE:FireServer(tool) end)
    
    local startTime = os.clock()
    while os.clock() - startTime < timeout do
        if (tool:GetAttribute("d") == true) == shouldBeFavorite then
            return true
        end
        task.wait(0.1)
    end
    
    warn(string.format("[Favorit] Timeout: %s", tool.Name))
    return false
end

