        if CONFIG[configKey] then
            for i, n in ipairs(names) do
                if n == CONFIG[configKey] then
                    currentIdx = i + 1
                    break
                end
            end
        end
        if currentIdx > #names then currentIdx = 1 end
        CONFIG[configKey] = names[currentIdx]
